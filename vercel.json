{
  "version": 2,
  "buildCommand": "npm run check",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "examples/fixtures.json"
    }
  },
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/healthz",
      "destination": "/api/index"
    },
    {
      "source": "/__qa/mobile",
      "destination": "/__qa-mobile.html"
    },
    {
      "source": "/((?!app.js|styles.css|openapi.json|favicon.svg|robots.txt|__qa/mobile|__qa-mobile.js|__qa-mobile.css|schemas/proof-case.json).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'"
        },
        {
          "key": "Content-Language",
          "value": "en"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/profiles/authorized-purchase-v1",
      "destination": "/profiles/authorized_purchase/v1",
      "permanent": true
    }
  ]
}
