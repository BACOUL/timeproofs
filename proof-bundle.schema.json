{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TimeProofs Proof Bundle v0.2",
  "description": "JSON schema for TimeProofs proof bundles (.tproof.json) — version timeproofs-0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "canonical", "hash", "timestamp", "proof"],
  "properties": {
    "version": {
      "type": "string",
      "const": "timeproofs-0.2",
      "description": "Proof bundle version identifier"
    },
    "canonical": {
      "type": "string",
      "minLength": 10,
      "description": "Canonical string used for signature verification: <hash>|<issuedAt>|<issuer>|<nonce>"
    },
    "hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["SHA-256"],
          "description": "Hash algorithm used for the data"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Lowercase hex-encoded SHA-256 digest of the data"
        }
      }
    },
    "timestamp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuedAt", "issuer", "nonce"],
      "properties": {
        "issuedAt": {
          "type": "string",
          "format": "date-time",
          "description": "RFC3339 timestamp when the proof was issued"
        },
        "issuer": {
          "type": "string",
          "const": "https://api.timeproofs.io",
          "description": "Canonical issuer URL (frozen authority for v0.2)"
        },
        "nonce": {
          "type": "string",
          "minLength": 8,
          "description": "Unique nonce per proof"
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algo", "signature", "keyId"],
      "properties": {
        "algo": {
          "type": "string",
          "enum": ["Ed25519"],
          "description": "Signature scheme used by TimeProofs v0.2"
        },
        "signature": {
          "type": "string",
          "pattern": "^[a-f0-9]{128}$",
          "description": "Hex-encoded Ed25519 signature (64 bytes => 128 hex chars)"
        },
        "publicKey": {
          "type": "string",
          "description": "Optional informational public key (ignored during verification)"
        },
        "keyId": {
          "type": "string",
          "minLength": 3,
          "description": "Identifier used to reference the public key (JWKS future use)"
        }
      }
    },
    "meta": {
      "type": "object",
      "description": "Optional local-only metadata attached by the user or application",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "description": "Normalized category of the data",
          "enum": [
            "document",
            "image",
            "video",
            "code",
            "dataset",
            "model",
            "log",
            "contract",
            "release",
            "config",
            "archive",
            "financial-statement",
            "medical-record",
            "supply-record",
            "product-info",
            "ai-output",
            "ai-training-set",
            "ai-prompt",
            "audit-proof",
            "evidence"
          ]
        },
        "mime": { "type": "string" },
        "domain": { "type": "string" },
        "purpose": { "type": "string" },
        "createdBy": { "type": "string" },
        "tool": { "type": "string" },
        "labels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    },
    "userSign": {
      "type": "object",
      "description": "Optional local signature (not sent to server)",
      "additionalProperties": false,
      "required": ["publicKey", "algorithm", "signature"],
      "properties": {
        "publicKey": {
          "type": "string",
          "description": "Base64-encoded Ed25519 public key for user signature"
        },
        "algorithm": {
          "type": "string",
          "enum": ["Ed25519"],
          "description": "Algorithm used for the user's local signature"
        },
        "signature": {
          "type": "string",
          "description": "Base64-encoded signature over canonicalized metadata"
        }
      }
    }
  }
}
