{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TimeProofs Proof Bundle v0.2",
  "description": "JSON schema for TimeProofs proof bundles (.tproof.json) in version timeproofs-0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "hash", "timestamp", "proof"],
  "properties": {
    "version": {
      "type": "string",
      "const": "timeproofs-0.2",
      "description": "Bundle format version identifier"
    },
    "hash": {
      "type": "object",
      "required": ["algorithm", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["SHA-256"],
          "description": "Hash algorithm used for the data digest"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$",
          "description": "Hex-encoded SHA-256 digest of the data bytes"
        }
      }
    },
    "timestamp": {
      "type": "object",
      "required": ["issuedAt", "issuer", "nonce"],
      "additionalProperties": false,
      "properties": {
        "issuedAt": {
          "type": "string",
          "format": "date-time",
          "description": "RFC 3339 UTC timestamp when the proof was issued"
        },
        "issuer": {
          "type": "string",
          "format": "uri",
          "description": "Base URL of the issuing TimeProofs API"
        },
        "nonce": {
          "type": "string",
          "description": "Nonce to distinguish multiple proofs for the same hash (required in v0.2)"
        }
      }
    },
    "proof": {
      "type": "object",
      "required": ["algo", "keyId"],
      "additionalProperties": false,
      "properties": {
        "algo": {
          "type": "string",
          "enum": ["HMAC-SHA256+Ed25519"],
          "description": "Proof scheme identifier"
        },
        "hmac": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]+$",
          "description": "Hex-encoded HMAC-SHA256 (null if not present)"
        },
        "signature": {
          "type": ["string", "null"],
          "description": "Ed25519 signature (null in v0.2 until implemented)"
        },
        "publicKey": {
          "type": ["string", "null"],
          "description": "Ed25519 public key (null in v0.2 until implemented)"
        },
        "keyId": {
          "type": "string",
          "description": "Key identifier (future JWKS mapping)"
        }
      }
    },
    "meta": {
      "type": "object",
      "description": "Optional local-only metadata describing the context of the data",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "description": "Normalized data category",
          "enum": [
            "document",
            "image",
            "video",
            "code",
            "dataset",
            "model",
            "log",
            "contract",
            "release",
            "config",
            "archive",
            "financial-statement",
            "medical-record",
            "supply-record",
            "product-info",
            "ai-output",
            "ai-training-set",
            "ai-prompt",
            "audit-proof",
            "evidence"
          ]
        },
        "mime": { "type": "string" },
        "domain": { "type": "string" },
        "purpose": { "type": "string" },
        "createdBy": { "type": "string" },
        "tool": { "type": "string" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "userSign": {
      "type": "object",
      "description": "Optional local-only signature over meta or additional local context",
      "required": ["publicKey", "algorithm", "signature"],
      "additionalProperties": false,
      "properties": {
        "publicKey": { "type": "string" },
        "algorithm": { "type": "string", "enum": ["Ed25519"] },
        "signature": { "type": "string" }
      }
    }
  }
}
