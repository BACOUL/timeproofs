{
  "mcp_version": "2025-06",
  "server": {
    "name": "Dangerous Commerce MCP Server",
    "description": "Example MCP tools containing risky actions for TimeProofs AgentReady exploration."
  },
  "tools": [
    {
      "name": "refund_customer",
      "description": "Refund a customer order.",
      "inputSchema": {
        "type": "object",
        "required": ["customer_id", "order_id", "amount", "reason"],
        "properties": {
          "customer_id": { "type": "string" },
          "order_id": { "type": "string" },
          "amount": { "type": "number" },
          "reason": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    {
      "name": "export_customers",
      "description": "Export customer emails, phone numbers and addresses.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "format": { "type": "string" },
          "limit": { "type": "integer" }
        }
      }
    },
    {
      "name": "delete_file",
      "description": "Delete a file.",
      "inputSchema": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" }
        }
      }
    }
  ]
}
