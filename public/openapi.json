{
  "openapi": "3.1.0",
  "info": {
    "title": "TimeProofs V2 Reference API",
    "x-canonical-language": "en",
    "version": "2.0.0-alpha.1",
    "description": "Deterministic proof orchestration. SATISFIED is not truth, legality, compliance or legal admissibility. Private endpoints require a self-host trust policy and API key. Public preview only runs sandbox evidence."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local reference server"
    }
  ],
  "paths": {
    "/v1/profiles": {
      "get": {
        "summary": "List public versioned profiles",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProofProfile"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/v1/profiles/{name}/{version}": {
      "get": {
        "summary": "Get one public profile",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProofProfile"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "version",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/resolve": {
      "post": {
        "summary": "Resolve evidence under configured trust policy",
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resolution"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited"
          },
          "401": {
            "description": "Unauthorized"
          },
          "503": {
            "description": "Private API not configured"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveInput"
              }
            }
          }
        }
      }
    },
    "/v1/cases": {
      "post": {
        "summary": "Create and persist a private case",
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProofCase"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited"
          },
          "401": {
            "description": "Unauthorized"
          },
          "503": {
            "description": "Private API not configured"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveInput"
              }
            }
          }
        }
      }
    },
    "/v1/cases/{id}": {
      "get": {
        "summary": "Retrieve a private case",
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProofCase"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited"
          },
          "401": {
            "description": "Unauthorized"
          },
          "503": {
            "description": "Private API not configured"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/cases/{id}/evidence": {
      "post": {
        "summary": "Append evidence and recompute",
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProofCase"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited"
          },
          "401": {
            "description": "Unauthorized"
          },
          "503": {
            "description": "Private API not configured"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "$ref": "#/components/schemas/Evidence"
                    }
                  }
                },
                "required": [
                  "evidence"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/verify": {
      "post": {
        "summary": "Free verification under server-owned sandbox policy",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Verification"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "proofCase": {
                    "$ref": "#/components/schemas/ProofCase"
                  }
                },
                "required": [
                  "proofCase"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/v1/verify-private": {
      "post": {
        "summary": "Recompute under private configured policy",
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Verification"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited"
          },
          "401": {
            "description": "Unauthorized"
          },
          "503": {
            "description": "Private API not configured"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "proofCase": {
                    "$ref": "#/components/schemas/ProofCase"
                  }
                },
                "required": [
                  "proofCase"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/v1/demo": {
      "post": {
        "summary": "Run signed fixture reference stage (no real purchase)",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sandbox": {
                      "const": true
                    },
                    "proofCase": {
                      "$ref": "#/components/schemas/ProofCase"
                    },
                    "verification": {
                      "$ref": "#/components/schemas/Verification"
                    },
                    "acquisition": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  },
                  "required": [
                    "sandbox",
                    "proofCase",
                    "verification",
                    "acquisition"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "stage": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2
                  }
                },
                "required": [
                  "stage"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/v1/demo-policy": {
      "get": {
        "summary": "Read independently pinned demo public keys",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/v1/adapters": {
      "get": {
        "summary": "Read exact adapter capabilities and limits",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Reference health check",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "IntendedAction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "const": "purchase"
          },
          "principal": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "merchant": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "amount_minor": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,17}$"
          },
          "offer_id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "principal",
          "agent",
          "merchant",
          "currency",
          "amount_minor",
          "offer_id"
        ],
        "additionalProperties": false
      },
      "Evidence": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": [
              "jwt",
              "vc-jwt"
            ]
          },
          "token": {
            "type": "string",
            "maxLength": 32768
          }
        },
        "required": [
          "id",
          "format",
          "token"
        ],
        "additionalProperties": false
      },
      "ResolveInput": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string"
          },
          "action": {
            "$ref": "#/components/schemas/IntendedAction"
          },
          "evidence": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          }
        },
        "required": [
          "profile",
          "action"
        ],
        "additionalProperties": false
      },
      "ProofRequirement": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptedFormats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acquisition": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "label",
          "role",
          "checks",
          "dependsOn",
          "acceptedFormats",
          "acquisition"
        ],
        "additionalProperties": false
      },
      "ProofProfile": {
        "type": "object",
        "required": [
          "id",
          "version",
          "status",
          "requirements"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "requirements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProofRequirement"
            }
          }
        }
      },
      "Resolution": {
        "type": "object",
        "required": [
          "status",
          "requirements",
          "policyDigest",
          "evaluatedAt"
        ],
        "properties": {
          "status": {
            "enum": [
              "SATISFIED",
              "INCOMPLETE",
              "CONFLICT",
              "INVALID",
              "UNSUPPORTED"
            ]
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "satisfied": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "evidenceResults": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "policyDigest": {
            "type": "string"
          },
          "evaluatedAt": {
            "type": "integer"
          }
        }
      },
      "ProofCase": {
        "type": "object",
        "properties": {
          "version": {
            "const": "timeproofs.case/2"
          },
          "id": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "action": {
            "$ref": "#/components/schemas/IntendedAction"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          },
          "resolution": {
            "$ref": "#/components/schemas/Resolution"
          }
        },
        "required": [
          "version",
          "id",
          "profile",
          "action",
          "evidence",
          "resolution"
        ],
        "additionalProperties": false
      },
      "Verification": {
        "type": "object",
        "required": [
          "valid",
          "status",
          "reason"
        ],
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "recordedMatches": {
            "type": "boolean"
          },
          "computed": {
            "$ref": "#/components/schemas/Resolution"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  }
}
