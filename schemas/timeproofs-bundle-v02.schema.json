{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TimeProofs Proof Bundle v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "hash", "timestamp", "proof"],
  "properties": {
    "version": {
      "type": "string",
      "const": "timeproofs-0.2"
    },
    "hash": {
      "type": "object",
      "required": ["algorithm", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["SHA-256"]
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "timestamp": {
      "type": "object",
      "required": ["issuedAt", "issuer"],
      "additionalProperties": false,
      "properties": {
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "issuer": {
          "type": "string",
          "format": "uri"
        },
        "nonce": {
          "type": "string"
        }
      }
    },
    "proof": {
      "type": "object",
      "required": ["algo", "keyId"],
      "additionalProperties": false,
      "properties": {
        "algo": {
          "type": "string",
          "enum": ["HMAC-SHA256+Ed25519"]
        },
        "hmac": {
          "type": ["string", "null"]
        },
        "signature": {
          "type": ["string", "null"]
        },
        "publicKey": {
          "type": ["string", "null"]
        },
        "keyId": {
          "type": "string"
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "document",
            "image",
            "video",
            "code",
            "dataset",
            "model",
            "log",
            "contract",
            "release",
            "config",
            "archive",
            "financial-statement",
            "medical-record",
            "supply-record",
            "product-info",
            "ai-output",
            "ai-training-set",
            "ai-prompt",
            "audit-proof",
            "evidence"
          ]
        },
        "mime": { "type": "string" },
        "domain": { "type": "string" },
        "purpose": { "type": "string" },
        "createdBy": { "type": "string" },
        "tool": { "type": "string" },
        "labels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    },
    "userSign": {
      "type": "object",
      "required": ["publicKey", "algorithm", "signature"],
      "additionalProperties": false,
      "properties": {
        "publicKey": { "type": "string" },
        "algorithm": {
          "type": "string",
          "enum": ["Ed25519"]
        },
        "signature": { "type": "string" }
      }
    }
  }
}
