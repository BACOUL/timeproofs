{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TimeProofs Proof Bundle v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "canonical", "hash", "timestamp", "proof"],
  "properties": {
    "version": {
      "type": "string",
      "const": "timeproofs-0.2"
    },

    "canonical": {
      "type": "string",
      "description": "Canonical string used for signature verification: <hash>|<issuedAt>|<issuer>|<nonce>"
    },

    "hash": {
      "type": "object",
      "required": ["algorithm", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["SHA-256"]
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },

    "timestamp": {
      "type": "object",
      "required": ["issuedAt", "issuer", "nonce"],
      "additionalProperties": false,
      "properties": {
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "issuer": {
          "type": "string",
          "const": "https://api.timeproofs.io"
        },
        "nonce": {
          "type": "string"
        }
      }
    },

    "proof": {
      "type": "object",
      "required": ["algo", "signature", "keyId"],
      "additionalProperties": false,
      "properties": {
        "algo": {
          "type": "string",
          "enum": ["Ed25519"]
        },
        "signature": {
          "type": "string",
          "description": "Hex-encoded Ed25519 signature"
        },
        "keyId": {
          "type": "string",
          "example": "tp-v0-2-main"
        },
        "publicKey": {
          "type": "string",
          "description": "Optional informational public key (ignored during verification)"
        }
      }
    },

    "meta": {
      "type": "object",
      "description": "Optional metadata. Not interpreted or trusted by the API.",
      "additionalProperties": true
    }
  }
}
