{
  "name": "@timeproofs/sdk",
  "version": "2.0.0-alpha.1",
  "type": "module",
  "description": "Deterministic proof orchestration for autonomous actions",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./sdk/index.d.ts",
      "import": "./sdk/index.js"
    },
    "./core": {
      "types": "./src/core.d.ts",
      "import": "./src/core.js"
    }
  },
  "bin": {
    "timeproofs": "./bin/timeproofs.js"
  },
  "files": [
    "src",
    "sdk",
    "bin",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "demo": "node examples/purchase.js",
    "check": "node scripts/check.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BACOUL/timeproofs.git"
  },
  "license": "MIT"
}
