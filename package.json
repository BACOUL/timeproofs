{
  "name": "@timeproofs/agentready",
  "version": "0.1.0-alpha.0",
  "description": "Pre-deployment CI gate for agent-facing OpenAPI and MCP tools.",
  "private": true,
  "type": "module",
  "bin": {
    "agentready": "./bin/agentready.js"
  },
  "scripts": {
    "test:agentready-core": "node agentready-core/tests/run-agentready-core-tests.mjs",
    "test:agentready-cli": "node cli/tests/run-agentready-cli-tests.mjs",
    "test:agentready-action": "node cli/tests/run-agentready-action-smoke-test.mjs",
    "test:agentready-package": "node cli/tests/run-agentready-package-smoke-test.mjs",
    "test:agentready-community-release": "node cli/tests/run-agentready-community-release-workflow-test.mjs",
    "release:community:candidate": "node scripts/create-agentready-community-release-candidate.mjs",
    "agentready": "node bin/agentready.js",
    "agentready:scan:openapi": "node bin/agentready.js scan openapi",
    "agentready:scan:mcp": "node bin/agentready.js scan mcp"
  },
  "keywords": [
    "agentready",
    "ai-agents",
    "openapi",
    "mcp",
    "ci",
    "ci-gate",
    "tool-calling",
    "agent-facing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BACOUL/timeproofs.git"
  },
  "homepage": "https://timeproofs.io/agentready-ci.html",
  "bugs": {
    "url": "https://github.com/BACOUL/timeproofs/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "files": [
    "bin/agentready.js",
    "agentready-core/*.js",
    "agentready-core/simulation/*.js"
  ],
  "engines": {
    "node": ">=20"
  }
}
